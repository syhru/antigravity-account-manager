{
  "name": "antigravity-account-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "tsx --test tests/*.test.ts",
    "db:up": "docker compose --env-file .env.local up -d --wait postgres",
    "db:down": "docker compose --env-file .env.local stop postgres"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
